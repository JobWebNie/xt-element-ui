{
  "name": "xt-element-ui",
  "version": "2.2.3",
  "description": "基于 Vue 2.7 + ElementUI 的企业级组件库，提供丰富的自定义组件和扩展组件",
  "main": "lib/index.common.js",
  "unpkg": "lib/index.umd.min.js",
  "style": "lib/index.css",
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "dev": "vue-cli-service serve",
    "lib": "node scripts/build-lib.js",
    "build:components": "node scripts/build-components.js",
    "prepublishOnly": "npm run lib",
    "postinstall": "patch-package"
  },
  "peerDependencies": {
    "echarts": "^4.0.0",
    "element-ui": "^2.11.1",
    "vue": "^2.6.10"
  },
  "devDependencies": {
    "@vue/cli-service": "~4.5.19",
    "babel-plugin-component": "^1.1.1",
    "raw-loader": "^4.0.2",
    "sass": "^1.56.0",
    "sass-loader": "^10.5.2",
    "vuepress": "^1.9.10",
    "vuepress-plugin-demo-container": "^0.2.0",
    "vuepress-theme-reco": "^1.6.17"
  },
  "files": [
    "lib",
    "src/components",
    "src/components/theme",
    "src/styles",
    "src/utils",
    "src/index.js",
    "README.md",
    "CHANGELOG.md",
    "docs/components/**/*md",
    "docs/README.md"
  ],
  "dependencies": {
    "patch-package": "^8.0.1"
  },
  "keywords": [
    "vue",
    "vue2",
    "element-ui",
    "element",
    "ui",
    "components",
    "xt-element-ui",
    "chart",
    "table",
    "echarts",
    "component-library",
    "vue-components",
    "admin",
    "dashboard"
  ],
  "author": "XT-Element-UI Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JobWebNie/xt-element-ui/issues"
  },
  "homepage": "https://jobwebnie.github.io/xt-element-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JobWebNie/xt-element-ui.git"
  },
  "engines": {
    "node": ">=12.0.0",
    "npm": ">=6.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "Chrome >= 60",
    "Firefox >= 60",
    "Safari >= 10.1",
    "Edge >= 15"
  ]
}
